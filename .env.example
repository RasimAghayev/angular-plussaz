# The variables of the stack.
#
# Copy this file to var/.env and change the values there. Every command of the
# stack needs `--env-file var/.env`.

# The host port the application is reachable at.
APP_PORT=8080

# The address of the JSON API the application talks to. The public mock of the
# demonstration is the default.
API_BASE_URL=https://jsonplaceholder.typicode.com
